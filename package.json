{
  "name": "techstore",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/web && npm run dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "build": "cd apps/web && npm run build",
    "build:admin": "cd apps/admin && npm run build",
    "install:all": "npm install && cd apps/web && npm install && cd ../admin && npm install"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "@types/node": "^20.12.0"
  }
}
